{
  "name": "g-vector",
  "version": "0.1.0",
  "private": true,
  "description": "A small vector editor: pen, curvature and smart guides",
  "main": "out/main/index.js",
  "author": "Garam",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "icons": "node scripts/generate-icons.mjs",
    "package": "npm run icons && npm run build && electron-builder",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^3.0.0",
    "@garam/core": "0.1.0",
    "@garam/theme": "0.1.0",
    "@garam/ui": "0.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "32.3.3",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "vite": "^5.4.0",
    "vitest": "^4.1.11"
  }
}
