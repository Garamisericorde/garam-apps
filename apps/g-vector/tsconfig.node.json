{
  "extends": "../../tsconfig.base.json",
  "include": [
    "electron.vite.config.ts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "../../packages/core/src/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "types": ["electron-vite/node", "node"],
    "lib": ["ES2022"],
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@garam/core": ["../../packages/core/src/index.ts"]
    }
  }
}
